{
  "schemaVersion": 1,
  "atlasVersion": "2026.06",
  "defaultTag": "3.2605.4",
  "tagFormat": {
    "description": "建议 tag 可排序。常见格式为 major.yyMM.patch，例如 3.2509.7。定制 tag 可附加 +project-build，例如 3.2509.1+bn-2。",
    "examples": [
      "3.2506.1",
      "3.2509.7",
      "3.2512.8",
      "3.2509.1+bn-2",
      "3.2605.4"
    ]
  },
  "knownProjects": [
    "bn"
  ],
  "resolutionPolicy": {
    "unknownTag": "fallback_to_default_with_warning",
    "unknownProject": "fallback_to_mainline_with_warning",
    "customExtendsDefault": "mainline"
  }
}
