{
  "name": "btree-tool",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "keywords": [
    "behavior-tree",
    "groot2",
    "xml",
    "btcpp"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:btreeTool.openPreview",
    "onCommand:btreeTool.copyNode",
    "onCommand:btreeTool.pasteNodeSmart",
    "onCommand:btreeTool.undoEdit",
    "onCommand:btreeTool.pasteNodeAsChild",
    "onCommand:btreeTool.pasteNodeBefore",
    "onCommand:btreeTool.pasteNodeAfter",
    "onCommand:btreeTool.openSearch",
    "onCustomEditor:btreeTool.btlogEditor",
    "onStartupFinished",
    "onLanguage:xml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "btreeTool.openPreview",
        "title": "%command.openPreview.title%",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      },
      {
        "command": "btreeTool.copyNode",
        "title": "%command.copyNode.title%"
      },
      {
        "command": "btreeTool.pasteNodeSmart",
        "title": "%command.pasteNodeSmart.title%"
      },
      {
        "command": "btreeTool.undoEdit",
        "title": "%command.undoEdit.title%"
      },
      {
        "command": "btreeTool.pasteNodeAsChild",
        "title": "%command.pasteNodeAsChild.title%"
      },
      {
        "command": "btreeTool.pasteNodeBefore",
        "title": "%command.pasteNodeBefore.title%"
      },
      {
        "command": "btreeTool.pasteNodeAfter",
        "title": "%command.pasteNodeAfter.title%"
      },
      {
        "command": "btreeTool.openSearch",
        "title": "%command.openSearch.title%"
      }
    ],
    "keybindings": [
      {
        "command": "btreeTool.openSearch",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "webviewFocus && webviewId == 'btreeTool.preview'"
      },
      {
        "command": "btreeTool.copyNode",
        "key": "c c",
        "when": "webviewFocus && webviewId == 'btreeTool.preview' && !inputFocus"
      },
      {
        "command": "btreeTool.pasteNodeSmart",
        "key": "c v",
        "when": "webviewFocus && webviewId == 'btreeTool.preview' && !inputFocus"
      },
      {
        "command": "btreeTool.undoEdit",
        "key": "z z",
        "when": "webviewFocus && webviewId == 'btreeTool.preview' && !inputFocus"
      }
    ],
    "customEditors": [
      {
        "viewType": "btreeTool.btlogEditor",
        "displayName": "BTreeTool btlog playback",
        "selector": [
          {
            "filenamePattern": "*.btlog"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "btreeTool.openPreview",
          "when": "resourceLangId == xml || resourceExtname == .xml",
          "group": "navigation"
        }
      ],
      "editor/tab/context": [
        {
          "command": "btreeTool.openPreview",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "btreeTool.openPreview",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "atlas:editor": "electron Tools/atlas-editor/electron-main.cjs",
    "compile": "tsc -p ./",
    "package:vsix": "npm test && npx @vscode/vsce package --allow-missing-repository --out btree-tool-v${npm_package_version}.vsix",
    "test": "npm run compile && node --test dist/test/*.test.js tests/*.test.mjs",
    "watch": "tsc -w -p ./",
    "dev:link": "sh ./scripts/install-local-dev.sh",
    "dev:refresh": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "electron": "^43.0.0",
    "typescript": "^5.6.3"
  }
}
