<TreeNodesModel>
  <Action ID="ReturnFail">
  </Action>
  <Action ID="StageAndReturn">
    <input_port name="phase" default="" description="Stage name." />
    <input_port name="event" default="" description="Stage event." />
    <input_port name="return_status" default="failure" description="Returns SUCCESS only when set to success." />
  </Action>
  <Action ID="RaiseException">
    <input_port name="error_id" />
    <input_port name="error_level" />
    <input_port name="error_name" />
    <input_port name="error_details" />
    <output_port name="errorMsg" default="{errorMsg}" />
    <output_port name="out_error_id" default="{out_error_id}" />
    <output_port name="out_error_level" default="{out_error_level}" />
    <output_port name="out_error_name" default="{out_error_name}" />
    <output_port name="out_error_details" default="{out_error_details}" />
