  <Action ID="DecelerateNavi">
    <input_port name="prepare_dist" default="0.0" description="The prepare distance before obstacle. &quot;
                                  &quot;Special: if prepare_dist == -1, force stop immediately." />
    <input_port name="obs_dist" default="0.0" description="The distance of obstacle." />
    <input_port name="decelerate_stop" default="0" description="Is stop decelerate." />
    <input_port name="err_obs_dist" default="0.02" description="obs_dist = 0 if obs_dist &lt;= err_obs_dist else obs_dist." />
    <input_port name="mode" default="in" description="Mode: 'in' for inbound (distance to ending), 'out' for &quot;
                &quot;outbound (distance to starting)." />
    <output_port name="errorMsg" default="{errorMsg}" />
  </Action>
